# Passwords for each user profile defined in users.json
# The key must match the "password_env" field for each user.
ALICE_PASSWORD=your_garmin_password_here
BOB_PASSWORD=your_garmin_password_here

# Supabase project (used by `pacerai sync-facts` / `push-coaching-note` / etc.)
# Run supabase/schema.sql once in the Supabase SQL editor before syncing.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
